{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/investigation/**",
              "components/primitives/**",
              "components/project/**",
              "ui_kits/android/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Source Serif 4|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Source Serif 4, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|success|danger|warning)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'success' | 'danger' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|leadingIcon|trailingIcon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, leadingIcon, trailingIcon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevation|padded|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevation, padded, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|sm|md|lg)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|name|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: author, name, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='author'] > Literal[value!=/^(?:agent|user|system)$/]",
        "message": "<ChatBubble> author must be one of 'agent' | 'user' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectivityIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|style|key|ref|className|style|children)$/]",
        "message": "<ConnectivityIndicator> doesn't accept that prop. Declared props: mode, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectivityIndicator'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:cloud|hybrid|local)$/]",
        "message": "<ConnectivityIndicator> mode must be one of 'cloud' | 'hybrid' | 'local'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountermeasureReviewCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:rootCause|countermeasure|onAccept|onEdit|onReject|style|key|ref|className|style|children)$/]",
        "message": "<CountermeasureReviewCard> doesn't accept that prop. Declared props: rootCause, countermeasure, onAccept, onEdit, onReject, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GembaCheckCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:hypothesis|instructions|branch|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<GembaCheckCard> doesn't accept that prop. Declared props: hypothesis, instructions, branch, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hypothesis'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|text|key|ref|className|style|children)$/]",
        "message": "<Hypothesis> doesn't accept that prop. Declared props: id, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|label|hint|invalid|leadingIcon|wrapperStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: as, label, hint, invalid, leadingIcon, wrapperStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MaturityMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<MaturityMeter> doesn't accept that prop. Declared props: level, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ModeIndicator> doesn't accept that prop. Declared props: mode, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeIndicator'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:shallow|deep)$/]",
        "message": "<ModeIndicator> mode must be one of 'shallow' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeStatusMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|emphaticRuledOut|style|key|ref|className|style|children)$/]",
        "message": "<NodeStatusMarker> doesn't accept that prop. Declared props: status, size, emphaticRuledOut, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|domain|description|status|investigations|maturity|members|visibility|key|ref|className|style|children)$/]",
        "message": "<ProjectSummary> doesn't accept that prop. Declared props: name, domain, description, status, investigations, maturity, members, visibility."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectSummary'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:active|closed|draft)$/]",
        "message": "<ProjectSummary> status must be one of 'active' | 'closed' | 'draft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectSummary'] > JSXAttribute[name.name='visibility'] > Literal[value!=/^(?:Private|Team|Organisation)$/]",
        "message": "<ProjectSummary> visibility must be one of 'Private' | 'Team' | 'Organisation'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|withLabel|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, size, withLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:active|closed|draft)$/]",
        "message": "<StatusDot> status must be one of 'active' | 'closed' | 'draft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:targetNode|suggestion|onAccept|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<SuggestionCard> doesn't accept that prop. Declared props: targetNode, suggestion, onAccept, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValidatorReviewCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:decision|confidence|rationale|onAccept|onOverride|style|key|ref|className|style|children)$/]",
        "message": "<ValidatorReviewCard> doesn't accept that prop. Declared props: decision, confidence, rationale, onAccept, onOverride, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValidatorReviewCard'] > JSXAttribute[name.name='decision'] > Literal[value!=/^(?:root_cause|go_deeper)$/]",
        "message": "<ValidatorReviewCard> decision must be one of 'root_cause' | 'go_deeper'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": {
        "replaces": []
      },
      "Button": {
        "replaces": []
      },
      "Card": {
        "replaces": []
